# Render supplies DATABASE_URL from the PostgreSQL resource.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://codelab-i7hd.onrender.com
NODE_ENV=production
PORT=10000

# SMTP is required for verification and password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OKNEW <no-reply@example.com>
